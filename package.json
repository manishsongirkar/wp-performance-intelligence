{
  "name": "wp-performance-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first and web-based WordPress performance, SEO, migration comparison and regression intelligence.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "tsx apps/api/src/cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "fastify-multipart": "^5.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/cors": "^2.8.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.50.0",
    "lighthouse": "^12.3.0"
  }
}
