{
  "name": "wp-performance-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first and web-based WordPress performance, SEO, migration comparison and regression intelligence.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "wpi": "tsx apps/api/src/cli.ts",
    "ui": "vite build --config apps/web/vite.config.ts && tsx apps/api/src/server.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lighthouse": "12.8.2",
    "playwright": "1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
