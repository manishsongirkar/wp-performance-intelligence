# Mode: "local" (default) allows LocalWP-style hosts; "public" never connects to private/loopback addresses.
WPI_MODE=local
HOST=127.0.0.1
PORT=4178
# Optional: restrict audits (and every redirect hop) to these hosts and their subdomains.
# WPI_ALLOWED_HOSTS=example.com,my-site.local
# local mode only: hosts allowed to resolve to loopback/private addresses.
# WPI_PRIVATE_HOSTS=localhost,*.localhost,*.local,*.test,127.0.0.1,::1
WPI_TIMEOUT_MS=15000
WPI_MAX_BYTES=2000000
WPI_MAX_REDIRECTS=5
WPI_MAX_CONCURRENT=4
# Required when HOST is not loopback (min 16 chars); sent as "Authorization: Bearer <token>".
# WPI_API_TOKEN=
# Browser origins allowed to call the API.
# WPI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Where reports are saved (default: ~/Desktop).
# WPI_REPORTS_DIR=
